{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "testing",
  "version": "0.1.0",
  "identifier": "io.github.wkdsteve.testing",
  "build": {
    "frontendDist": "../ui/dist-mobile"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "title": "testing",
        "url": "index.mobile.html",
        "width": 420,
        "height": 860
      }
    ],
    "security": {
      "csp": {
        "default-src": "'none'",
        "script-src": "'self'",
        "style-src": "'self'",
        "img-src": "'self' blob:",
        "connect-src": "ipc: http://ipc.localhost",
        "base-uri": "'none'",
        "object-src": "'none'",
        "frame-ancestors": "'none'",
        "form-action": "'none'"
      },
      "freezePrototype": true,
      "capabilities": []
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "../assets/icons/testing-mobile/png/testing-mobile-32.png",
      "../assets/icons/testing-mobile/png/testing-mobile-128.png",
      "../assets/icons/testing-mobile/png/testing-mobile-256.png",
      "../assets/icons/testing-mobile/testing-mobile.ico"
    ],
    "android": {
      "minSdkVersion": 24
    }
  }
}
